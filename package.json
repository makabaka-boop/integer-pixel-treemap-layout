{
  "name": "integer-pixel-treemap",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Offline squarified treemap editor with exact integer-pixel layout (Lit + TypeScript)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "jsdom": "^25.0.1",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
